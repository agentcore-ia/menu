NEUROREST_DATA_PROVIDER=mock

# Opcion Supabase REST real
NEUROREST_SUPABASE_URL=https://eqnjyygokjinmsfvogxi.supabase.co
NEUROREST_SUPABASE_API_KEY=
NEUROREST_SUPABASE_WRITE_API_KEY=
NEUROREST_SUPABASE_STORAGE_API_KEY=
NEUROREST_ADMIN_TOKEN=
NEUROREST_SUPABASE_STORAGE_BUCKET=menu-videos

# Si usas postgres:
NEUROREST_DB_PROVIDER=postgres
DATABASE_URL=postgres://user:password@localhost:5432/neurorest

# Si usas mysql:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=neurorest

# Tablas esperadas por el adaptador SQL
NEUROREST_ACCOUNTS_TABLE=accounts
NEUROREST_CATEGORIES_TABLE=menu_categories
NEUROREST_PRODUCTS_TABLE=menu_products
