{
  "framework": "vite",
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "saborapampa.menu.net.ar"
        }
      ],
      "dest": "/saborapampa.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "kika.menu.net.ar"
        }
      ],
      "dest": "/kika.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "almendra.menu.net.ar"
        }
      ],
      "dest": "/almendra.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
