{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "saborapampa.menu.net.ar"
        }
      ],
      "destination": "/saborapampa.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kika.menu.net.ar"
        }
      ],
      "destination": "/kika.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "almendra.menu.net.ar"
        }
      ],
      "destination": "/almendra.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lodetoto.menu.net.ar"
        }
      ],
      "destination": "/lodetoto.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "racing.menu.net.ar"
        }
      ],
      "destination": "/racing.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "babson.menu.net.ar"
        }
      ],
      "destination": "/babson.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "troka.menu.net.ar"
        }
      ],
      "destination": "/troka.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "panacea.menu.net.ar"
        }
      ],
      "destination": "/panacea.html"
    },
    {
      "source": "/almendra",
      "destination": "/almendra.html"
    },
    {
      "source": "/almendra/:path*",
      "destination": "/almendra.html"
    },
    {
      "source": "/kika",
      "destination": "/kika.html"
    },
    {
      "source": "/kika/:path*",
      "destination": "/kika.html"
    },
    {
      "source": "/sabor-a-pampa",
      "destination": "/saborapampa.html"
    },
    {
      "source": "/sabor-a-pampa/:path*",
      "destination": "/saborapampa.html"
    },
    {
      "source": "/lodetoto",
      "destination": "/lodetoto.html"
    },
    {
      "source": "/lodetoto/:path*",
      "destination": "/lodetoto.html"
    },
    {
      "source": "/babson",
      "destination": "/babson.html"
    },
    {
      "source": "/babson/:path*",
      "destination": "/babson.html"
    },
    {
      "source": "/troka",
      "destination": "/troka.html"
    },
    {
      "source": "/troka/:path*",
      "destination": "/troka.html"
    },
    {
      "source": "/panacea",
      "destination": "/panacea.html"
    },
    {
      "source": "/panacea/:path*",
      "destination": "/panacea.html"
    },
    {
      "source": "/racing",
      "destination": "/racing.html"
    },
    {
      "source": "/racing/:path*",
      "destination": "/racing.html"
    },
    {
      "source": "/api/accounts/:accountId/pay-card",
      "destination": "/api/accounts/:accountId/orders?accion=pagar-con-tarjeta"
    },
    {
      "source": "/:account((?!api|assets|dishes|favicon\\.svg|favicon\\.png|icons\\.svg|service-worker\\.js|sabor-a-pampa|kika|almendra|lodetoto|babson|troka|panacea|racing).*)",
      "destination": "/host.html"
    }
  ]
}
